{
  "name": "pef-virtual-edge",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic logical PEF hardware-independent emulator",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "emulate": "node bin/pef-emulator.js --all",
    "smoke": "node --test test/*.test.js && node bin/pef-emulator.js --all && node bin/pef-loopback-lab.js",
    "lab:loopback": "node bin/pef-loopback-lab.js",
    "dashboard": "node bin/pef-dashboard.js",
    "edge": "node bin/pef-edge.js",
    "ports:conformance": "node bin/pef-port-conformance.js",
    "traces:check": "node bin/pef-golden-traces.js",
    "device:preflight": "node bin/pef-device-preflight.js",
    "device:candidates": "node bin/pef-device-candidates.js",
    "arm64:profile": "node bin/pef-arm64-vm.js",
    "arm64:d3": "node bin/pef-arm64-d3.js",
    "arm64:compare": "node bin/pef-arm64-compare.js",
    "arm64:e1": "node bin/pef-arm64-e1.js",
    "arm64:e2": "node bin/pef-arm64-e2.js",
    "arm64:e5": "node bin/pef-arm64-e5.js",
    "arm64:f1": "node bin/pef-arm64-f1.js",
    "arm64:f2": "node bin/pef-arm64-f2.js",
    "m1:evidence": "node bin/pef-m1-evidence.js",
    "m1:evidence:verify": "node bin/pef-m1-evidence.js --verify",
    "m1:evidence:video": "node bin/pef-m1-video.js",
    "m1:evidence:verify-video": "node bin/pef-m1-video.js --verify",
    "m3:supervise": "node bin/pef-m3-supervisor.js",
    "m3:evidence": "node bin/pef-m3-evidence.js",
    "m3:recovery": "node bin/pef-m3-recovery.js",
    "m3:bundle": "node bin/pef-m3-bundle.js",
    "m3:bundle:verify": "node bin/pef-m3-bundle.js --verify",
    "m3:bundle:video": "node bin/pef-m3-bundle.js --video",
    "m3:bundle:verify-video": "node bin/pef-m3-bundle.js --verify-video",
    "m4:property": "node bin/pef-m4-property.js",
    "m4:host": "node bin/pef-m4-host.js",
    "m4:commonality": "node bin/pef-m4-commonality.js",
    "m4:bundle": "node bin/pef-m4-bundle.js",
    "m4:bundle:verify": "node bin/pef-m4-bundle.js --verify",
    "m5:install": "node bin/pef-m5-install.js",
    "m5:lab": "node bin/pef-m5-lab.js",
    "m5:linux": "node bin/pef-m5-lab.js --require-linux",
    "m5:systemd:contract": "node bin/pef-m5-systemd.js"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
