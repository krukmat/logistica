{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PEF Harness Run Evidence v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "scenario_id",
    "gate_ids",
    "profile",
    "status",
    "evidence_complete",
    "device_id",
    "software_revision",
    "fixture_revision",
    "driver",
    "timestamp_utc",
    "t0_mono_ns",
    "t1_mono_ns",
    "artifacts",
    "oracle",
    "cleanup_status",
    "sample_count",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 6
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^SC-"
    },
    "gate_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "profile": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "enum": [
        "NOT_RUN",
        "BLOCKED",
        "ERROR",
        "FAIL",
        "PASS"
      ]
    },
    "evidence_complete": {
      "type": "boolean"
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "software_revision": {
      "type": "string",
      "minLength": 1
    },
    "fixture_revision": {
      "type": "string",
      "minLength": 1
    },
    "driver": {
      "type": "string",
      "minLength": 3
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "t0_mono_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "t1_mono_ns": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "uri",
          "sha256"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectation",
        "observation",
        "result"
      ],
      "properties": {
        "expectation": {
          "type": "string"
        },
        "observation": {
          "type": "string"
        },
        "result": {
          "enum": [
            "UNASSESSED",
            "PASS",
            "FAIL"
          ]
        }
      }
    },
    "cleanup_status": {
      "enum": [
        "NOT_STARTED",
        "CLEAN",
        "DIRTY",
        "FAILED"
      ]
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
